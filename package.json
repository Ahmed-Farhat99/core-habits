    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "moment": "^2.30.1",
    "obsidian": "^1.5.7",
    "postcss": "^8.5.28",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "fix-webm-duration": "^1.0.6"
