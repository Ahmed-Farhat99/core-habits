{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "src/types/contracts.d.ts",
    "src/config/colors.js",
    "src/config/defaultSettings.js",
    "src/config/headings.js",
    "src/domain/HabitDataContract.js",
    "src/services/HabitJournalService.js"
  ]
}
